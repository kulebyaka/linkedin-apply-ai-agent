# =============================================================================
# SECRETS — must be set in .env; never commit real values
# =============================================================================

# LinkedIn login (required for scraping features)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# LLM API keys — set at least one
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
ANTHROPIC_API_KEY=

# Magic-link email service — https://resend.com
RESEND_API_KEY=

# JWT signing key — generate with: openssl rand -hex 32
JWT_SECRET=

# Local-development auth bypass. When true, exposes POST /api/auth/dev-login
# which mints a JWT for DEV_AUTH_EMAIL without email verification. The app
# REFUSES TO START if this is true and APP_URL is not localhost.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=dev@local.test

# =============================================================================
# ENVIRONMENT-SPECIFIC — differ across dev / staging / production
# =============================================================================

# Application
DEBUG=false
LOG_LEVEL=INFO

# Default LLM provider. Users can override per operation (CV generation, job
# filtering, filter-prompt generation) in Settings → Model preferences.
PRIMARY_LLM_PROVIDER=openai      # openai | deepseek | grok | anthropic

# Default model per provider. Store BARE model ids — the LiteLLM route prefix
# (openai/, anthropic/, xai/, deepseek/) is attached automatically.
OPENAI_MODEL=gpt-4o
DEEPSEEK_MODEL=deepseek-chat
GROK_MODEL=grok-2-1212
ANTHROPIC_MODEL=claude-sonnet-4-5

# Repository backend. NOTE: the default is `memory`, so persistence is opt-in —
# with `memory`, every job is lost on restart.
REPO_TYPE=memory                 # memory (dev) | sqlite (production)
DB_PATH=./data/jobs.db

# LinkedIn search — global fallback, used ONLY when no user has search
# preferences stored in the DB
LINKEDIN_SEARCH_KEYWORDS=
LINKEDIN_SEARCH_LOCATION=
LINKEDIN_SEARCH_REMOTE_FILTER=      # remote | on-site | hybrid
LINKEDIN_SEARCH_DATE_POSTED=        # 24h | week | month
LINKEDIN_SEARCH_EXPERIENCE_LEVEL=   # JSON list: ["entry","mid-senior"]
LINKEDIN_SEARCH_JOB_TYPE=           # JSON list: ["full-time","contract"]

# LinkedIn scheduler. When false, no browser is launched and no queue consumer
# starts (except one spun up by startup recovery).
LINKEDIN_SEARCH_SCHEDULE_ENABLED=false
LINKEDIN_SEARCH_INTERVAL_HOURS=1

# Operational alerts to the administrator (e.g. the LinkedIn session looks
# unauthenticated). Empty disables all admin alerts.
ADMIN_ALERT_EMAIL=

# Development toggles
SEED_JOBS_FROM_FILE=false        # true REPLACES scraping with fixture replay
BROWSER_HEADLESS=true            # false for visual debugging

# Magic link
APP_URL=http://localhost:5173    # Base URL for magic link callback (change in production)
RESEND_FROM=LinkedIn Agent <noreply@resend.dev>  # Must be a verified Resend domain

# API server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# Frontend (Vite — VITE_ prefix required to expose to the browser).
# Production images bake VITE_API_BASE_URL="" so the browser uses relative /api paths.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false

# =============================================================================
# OPTIONAL OVERRIDES — have sensible defaults in src/config/settings.py;
# uncomment only if you need to change them
# =============================================================================

# --- Job filter -------------------------------------------------------------
# Two-threshold routing. Below reject → saved as `filtered_out`, no CV generated.
# Below warning → still reviewed, but badged with red flags. Per-user values in
# Settings override both.
# JOB_FILTER_ENABLED=true
# JOB_FILTER_REJECT_THRESHOLD=30
# JOB_FILTER_WARNING_THRESHOLD=70

# --- Auto-refining filter prompt -------------------------------------------
# Global kill switch. Per-user opt-in still defaults to OFF. Proposals are
# never applied without the user accepting them in Settings.
# AUTO_REFINE_ENABLED=true
# AUTO_REFINE_INTERVAL_HOURS=168
# AUTO_REFINE_MIN_SIGNALS=10
# AUTO_REFINE_SIGNAL_CAP=50

# --- Scrape failure recovery ----------------------------------------------
# A detail page yielding fewer than MIN_DESCRIPTION_CHARS becomes
# `scrape_failed` (retry-eligible) instead of producing a CV from nothing.
# SCRAPER_MIN_DESCRIPTION_CHARS=200
# SCRAPER_MAX_ATTEMPTS=3
# SCRAPER_RETRY_BACKOFF_MINUTES=60

# --- Dynamic model catalog -------------------------------------------------
# Live model list + pricing from LiteLLM's community JSON; the static
# MODEL_CATALOG is the offline fallback.
# MODEL_CATALOG_DYNAMIC_ENABLED=true
# MODEL_CATALOG_CACHE_PATH=./data/model_catalog_cache.json
# MODEL_CATALOG_REFRESH_HOURS=24

# --- CV output -------------------------------------------------------------
# CV_TEMPLATE_NAME must name a directory under src/templates/cv/
# CV_TEMPLATE_NAME=compact       # modern | compact | profile-card
# CV_COMPOSER_HALLUCINATION_POLICY=strict   # strict | warn | disabled

# --- LinkedIn browser ------------------------------------------------------
# LINKEDIN_PROXY_SERVER=         # e.g. socks5://127.0.0.1:1080 — route through a stable IP
# LINKEDIN_API_KEY=              # LinkedIn API access (rare)
